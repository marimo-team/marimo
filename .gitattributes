# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true
packages/client/src/protocol.ts linguist-generated=true
packages/client/src/operations.ts linguist-generated=true

# SSE frames end with a blank line, including the final frame.
protocols/host/**/*.sse whitespace=-blank-at-eof
