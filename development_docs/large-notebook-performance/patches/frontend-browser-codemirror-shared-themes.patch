# Three extensions call EditorView.theme()/baseTheme() inside a per-cell factory, so every editor
# adds 7 CSS rules and a unique scope class to CodeMirror's <style> element (535 rules at 50 cells,
# ~3,700 at 500). With unique rules the style sheet text changes on every editor mount, which makes
# Chrome recalculate style for most of the document.
# VALIDATED together with the style-mod patch (experiment "load"): style recalc during a 250-cell
# load 70.4 s -> 4.3 s. Alone it changes little, because style-mod still rewrites the sheet.

--- a/frontend/src/core/codemirror/go-to-definition/extension.ts
+++ b/frontend/src/core/codemirror/go-to-definition/extension.ts
@@ -3,6 +3,15 @@
 import { createUnderlinePlugin, underlineField } from "./underline";
 import { goToDefinitionWithLspFallback } from "./utils";
 
+
+// One style module for every editor: a theme created per cell adds its rules again.
+const underlineTheme = EditorView.baseTheme({
+  ".underline": {
+    textDecoration: "underline",
+    cursor: "pointer",
+    color: "var(--link)",
+  },
+});
 /**
  * Create a go-to-definition extension.
  */
@@ -12,12 +21,6 @@
     createUnderlinePlugin((view) => {
       goToDefinitionWithLspFallback(view);
     }),
-    EditorView.baseTheme({
-      ".underline": {
-        textDecoration: "underline",
-        cursor: "pointer",
-        color: "var(--link)",
-      },
-    }),
+    underlineTheme,
   ];
 }
