{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "scripts"]
}
